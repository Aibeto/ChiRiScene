	fragment@48 {
		target = <0xffffffff>;

		__overlay__ {

			usb_phy_ps {
				phandle = <0xac>;

				usb3phy_portselect_default {
					phandle = <0x49>;

					mux {
						pins = "gpio11";
						function = "usb_phy";
					};

					config {
						pins = "gpio11";
						bias-pull-down;
						drive-strength = <0x2>;
					};
				};
			};
		};
	};

